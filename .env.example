# HackSpire — Environment Configuration

PORT=3000
# Set to 1 in production (HTTPS / Vercel) so cookies get the Secure flag
SECURE_COOKIES=1

# 32+ random characters hex in production
SESSION_SECRET=change-me-to-a-long-random-secret-min-32-chars

# Hard cap on membership count (enforced at both DB trigger and app level)
MAX_MEMBERS=10

# Supabase Configuration (Leave blank to use local SQLite)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_ANON_KEY=your-supabase-anon-key
